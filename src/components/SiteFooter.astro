---
import { email, profileLinks } from '../data/site';
---

<footer class="site-footer">
  <ul>
    {
      profileLinks.map(({ id, label, url }) => (
        <li>
          <a href={url} data-testid={`link-${id}`}>
            {label}
          </a>
        </li>
      ))
    }
    <li>
      <a href={`mailto:${email}`} data-testid="link-email">{email}</a>
    </li>
  </ul>
</footer>

<style>
  @layer components {
    .site-footer {
      margin-top: var(--space-12);
      padding: var(--space-6) 0 var(--space-4);
      border-top: 1px solid var(--border);
      color: var(--muted-foreground);
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }
</style>
