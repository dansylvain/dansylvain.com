---
const links = [
  { href: '/', label: 'Accueil', testId: 'nav-home' },
  { href: '/portfolio/', label: 'Portfolio', testId: 'nav-portfolio' },
  { href: '/blog/', label: 'Blog', testId: 'nav-blog' },
  { href: '/demos/', label: 'Démos', testId: 'nav-demos' },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string): boolean =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <nav aria-label="Navigation principale">
    <ul>
      {
        links.map(({ href, label, testId }) => (
          <li>
            <a href={href} data-testid={testId} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
