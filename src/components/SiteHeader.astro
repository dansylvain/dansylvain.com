---
import ThemeSelect from './ThemeSelect.astro';

const links = [
  { href: '/', label: 'Home', testId: 'nav-home' },
  { href: '/cv/', label: 'CV', testId: 'nav-cv' },
  { href: '/portfolio/', label: 'Portfolio', testId: 'nav-portfolio' },
  { href: '/blog/', label: 'Blog', testId: 'nav-blog' },
  { href: '/demos/', label: 'Demos', testId: 'nav-demos' },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string): boolean =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <nav aria-label="Main navigation">
    <ul>
      {
        links.map(({ href, label, testId }) => (
          <li>
            <a href={href} data-testid={testId} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeSelect />
</header>

<style>
  @layer components {
    .site-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3) var(--space-5);
      padding: var(--space-6) 0 var(--space-4);
      border-bottom: 1px solid var(--border);
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    [aria-current='page'] {
      font-weight: 700;
    }
  }
</style>
