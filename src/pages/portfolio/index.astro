---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projets = (await getCollection('projets', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Portfolio" description="Projects, technical choices and code.">
  <h1>Portfolio</h1>
  <p>Projects, technical choices and code.</p>
  {
    projets.map(({ id, data }) => (
      <article>
        <h2>
          <a href={`/portfolio/${id}/`} data-testid={`project-${id}`}>
            {data.title}
          </a>
        </h2>
        <p>{data.summary}</p>
        <p class="tags">{data.tech.join(' · ')}</p>
      </article>
    ))
  }
</BaseLayout>
