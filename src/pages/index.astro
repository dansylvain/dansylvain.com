---
import BaseLayout from '../layouts/BaseLayout.astro';
import { home, name } from '../data/site';
---

<BaseLayout title="Home" description={home.description}>
  <h1>{name}</h1>
  <p>{home.intro}</p>

  <h2>Skills</h2>
  <ul>
    {home.skills.map((skill) => <li>{skill}</li>)}
  </ul>

  <h2>Background</h2>
  <p><a href="/cv/" data-testid="home-cv">Read my CV</a></p>
</BaseLayout>
